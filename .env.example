# Bay Bay - Configuration d'environnement (Exemple)
# Copiez ce fichier sous le nom '.env' et modifiez les valeurs

# URL de connexion à la base de données
# Exemple SQLite (Local) : sqlite:///baybay.db
# Exemple MySQL (Distant) : mysql+pymysql://utilisateur:motdepasse@hote:port/mabase
DATABASE_URL=sqlite:///baybay.db

# Clé secrète de l'application Flask
SECRET_KEY=remplacez-moi-par-une-cle-securisee-en-production
